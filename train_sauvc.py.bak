from ultralytics import YOLO
def main():
    model=YOLO("yolov8n.pt")  # load a pretrained model (recommended for training)
    model.train(
        data='sauvc.yaml'
        epochs=400
        patience=100
        imgsz=960
        batch=16
        device="mps"
        workers=0
        cache=True
        speed=0
        project="runs"
        name="sauvc"
        hsv_h=0.02
        hsv_s=0.8
        hsv_v=0.5
        deegrees=10
        scale=0.6
        fliplr=0.5
        flipud=0.0
        mosaic=1.0
        close_mosaic=15


    )
metrics = model.val()  # evaluate model performance on the validation set
  # mAP50-95 — усреднение по порогам IoU от 0.5 до 0.95.
    # Строгая метрика, требует точных рамок. Главное число.
print("mAP50-95:", round(metrics.box.map, 4))

    # mAP50 — порог IoU только 0.5, т.е. "рамка примерно там".
    # Мягче, растёт быстрее, удобна на ранних экспериментах.
print("mAP50:   ", round(metrics.box.map50, 4))

    # Где лежат веса. best.pt — лучшая эпоха по метрике,
    # last.pt — самая последняя. Для инференса берём best.pt.
print("Веса и графики:", model.trainer.save_dir)


# Обязательно на macOS, а не украшение: даталоадер PyTorch
# поднимает процессы через spawn, и каждый заново импортирует
# этот файл. Без гварда обучение запустится в каждом дочернем
# процессе → бесконечное размножение и падение с
# "An attempt has been made to start a new process before the
#  current process has finished its bootstrapping phase".
if __name__ == "__main__":
    main()
